# Copy to .env and fill in. Never commit .env.

# LLM: any OpenAI-compatible endpoint
# Local llama-server: http://localhost:8081/v1 (the key can be any non-empty text)
LLM_BASE_URL=http://localhost:8081/v1
LLM_MODEL=
LLM_API_KEY=

# Services
MLFLOW_TRACKING_URI=http://localhost:5000
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
KUBECONFIG=

# Project config (namespace, DAGs, model names): mlops-agent.yaml by default
MLOPS_AGENT_CONFIG=

# Model promotion
QUALITY_GATE_F1=0.45

# Docker Compose (Airflow)
# AIRFLOW_UID: your user ID (id -u), so files Airflow writes stay yours.
# AIRFLOW__API_AUTH__JWT_SECRET: a random value, for example from: openssl rand -hex 32
# FERNET_KEY: encrypts stored connections, from: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_UID=
AIRFLOW__API_AUTH__JWT_SECRET=
FERNET_KEY=
