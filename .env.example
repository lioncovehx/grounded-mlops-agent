# Copy to .env and fill in. Never commit .env.

# LLM: any OpenAI-compatible endpoint
# Local llama-server: http://localhost:8081/v1 (the key can be any non-empty text)
LLM_BASE_URL=http://localhost:8081/v1
LLM_MODEL=
LLM_API_KEY=

# Services
MLFLOW_TRACKING_URI=http://localhost:5000
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
KUBECONFIG=

# Agent permissions
AGENT_ALLOWED_NAMESPACE=mlops-app
AGENT_ALLOWED_DAGS=training_pipeline

# Model promotion
QUALITY_GATE_F1=0.45
